# Copy to .env.local for your own computer, and add the same names in Vercel (Settings -> Environment Variables).

# The board is OPEN by default: anyone with the link can see it and add, edit and delete tasks (no sign-in). Set this to true to require the
# magic-link sign-in with admin and member roles instead (then the Supabase publishable key, SESSION_SECRET and TASKS_ADMIN_EMAILS are needed).
REQUIRE_LOGIN=
# Shared storage: SUPABASE_URL and SUPABASE_SECRET_KEY are needed on Vercel (without them the board saves to data/*.local.json on your computer only).

# Supabase (the website's project is fine). Dashboard -> Project Settings -> API Keys / Connect.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=      # sb_publishable_... : sends and checks the magic links
SUPABASE_SECRET_KEY=           # sb_secret_... : the task table and the team list. Server only, never in the code.

# Signs the session cookie. Any long random text: openssl rand -hex 32
SESSION_SECRET=

# The first admin(s), comma-separated. These emails can always ask for a sign-in link and are made admins.
TASKS_ADMIN_EMAILS=marketing@qualityroofingspecialists.com

# Optional: the app's public address, for the links in the emails (otherwise the address the request came in on)
APP_URL=
